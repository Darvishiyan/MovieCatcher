# Telegram credentials (replace every placeholder; never commit your real .env file)
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Access control: set at least one user ID or chat ID. Separate multiple IDs with commas.
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# DOWNLOAD_PATH is the host path shared with Jellyfin.
# DOWNLOAD_ROOT is the corresponding path inside this container.
DOWNLOAD_PATH=./downloads
DOWNLOAD_ROOT=/downloads

# Persistent Pyrogram session data on the host.
SESSION_PATH=./data

# Runtime user. Match these to the owner of DOWNLOAD_PATH and SESSION_PATH on Linux.
PUID=1000
PGID=1000

# Download and logging options.
MAX_FILE_SIZE_GB=10
LOG_LEVEL=INFO
